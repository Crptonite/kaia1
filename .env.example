# ============================================================
#  KAIA — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit your .env file to version control.
# ============================================================

# ----- Database (PostgreSQL) --------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/kaia"

# ----- Clerk Authentication ---------------------------------
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk redirect URLs (do not change unless you change routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/auth/sign-up/complete"

# ----- OpenAI -----------------------------------------------
# https://platform.openai.com/api-keys
OPEN_AI_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ----- Stripe -----------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISH_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-signing-secret"

# Product price IDs — create these in your own Stripe dashboard
NEXT_PUBLIC_STRIPE_PLUS_PLAN_PRICE_ID="price_xxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_ULTIMATE_PLAN_PRICE_ID="price_xxxxxxxxxxxxxxxxxxxxxxxxx"

# ----- Pusher (real-time chat) ------------------------------
# https://dashboard.pusher.com
PUSHER_APP_ID="xxxxxxx"
PUSHER_APP_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
PUSHER_APP_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
PUSHER_CLUSTER="eu"

NEXT_PUBLIC_PUSHER_APP_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ----- Uploadcare (file/image uploads) ----------------------
# https://uploadcare.com/dashboard/
NEXT_PUBLIC_UPLOAD_CARE_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxxxxxx"

# ----- Nodemailer (email sending) ---------------------------
# Use an SMTP provider (Gmail, SendGrid, Resend, etc.)
NODEMAILER_EMAIL="your-email@example.com"
NODEMAILER_PASSWORD="your-app-password"

# ----- App URL ----------------------------------------------
NEXT_PUBLIC_URL="http://localhost:3000"

# ----- Blog (optional — WordPress REST API or compatible) ---
# Only needed if you use the integrated blog feature on the landing page.
# Point these to your own WordPress (or headless CMS) instance.
BLOG_BASE_URL="https://your-blog-site.com"
BLOG_POSTS_URL="https://your-blog-site.com/wp-json/wp/v2/posts"
BLOG_IMAGES_URL="https://your-blog-site.com/wp-json/wp/v2/media"
BLOG_USERS_URL="https://your-blog-site.com/wp-json/wp/v2/users/"
BLOG_UPLOADS_URL="https://your-blog-site.com/wp-content/uploads/"
